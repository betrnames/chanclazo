{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/cruise",
      "destination": "/cruise.html"
    },
    {
      "source": "/strike",
      "destination": "/strike.html"
    },
    {
      "source": "/fling",
      "destination": "/fling.html"
    },
    {
      "source": "/match",
      "destination": "/match.html"
    },
    {
      "source": "/demos",
      "destination": "/demos.html"
    },
    {
      "source": "/((?!cruise|strike|fling|match|demos).*)",
      "destination": "/index.html"
    }
  ]
}