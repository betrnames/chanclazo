{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/strike",
      "destination": "/strike.html"
    },
    {
      "source": "/fling",
      "destination": "/fling.html"
    },
    {
      "source": "/match",
      "destination": "/match.html"
    },
    {
      "source": "/lore",
      "destination": "/lore.html"
    }
  ],
  "redirects": [
    {
      "source": "/demos",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/demos.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cruise",
      "destination": "/strike",
      "permanent": false
    },
    {
      "source": "/cruise.html",
      "destination": "/strike",
      "permanent": false
    },
    {
      "source": "/survival",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/survival.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(fling|match|strike|lore)?(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/fling.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}