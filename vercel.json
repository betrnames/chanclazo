{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/cruise",
      "destination": "/cruise.html"
    },
    {
      "source": "/strike",
      "destination": "/strike.html"
    },
    {
      "source": "/((?!cruise|strike).*)",
      "destination": "/index.html"
    }
  ]
}