{
  "name": "chanclazo",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Chanclazo: Day of the Dead browser games (Chancla Strike and Chanclazo Match).",
  "author": "betrnames",
  "homepage": "https://chanclazo.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/betrnames/chanclazo.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:games && npm run build:astro && npm run build:merge",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview",
    "deploy:vercel": "npm run build && vercel --prod",
    "dev:games": "vite",
    "build:games": "tsc -b && vite build",
    "build:astro": "astro build",
    "build:merge": "node scripts/merge-dist.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.6.0",
    "matter-js": "^0.20.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-resizable-panels": "^4.7.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "astro": "^5.18.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.5"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
