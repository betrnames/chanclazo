---
import Base from '../layouts/Base.astro';
import PapelPicado from '../components/PapelPicado.astro';
import Petals from '../components/Petals.astro';
import ChanclaAnimation from '../components/ChanclaAnimation.astro';
import MarqueeTitle from '../components/MarqueeTitle.astro';
import PlayNow from '../components/PlayNow.astro';
import Character from '../components/Character.astro';
import GameCard from '../components/GameCard.astro';

---
<Base>
  <header class="hero" id="top" data-title="1">
    <Petals />
    <div class="hero-rail">
      <PapelPicado />
    </div>

    <div class="hero-stage">
      <div class="layer left desk-only">
        <Character kind="abuela" class="abuela-windup" />
      </div>

      <div class="focal">
        <div class="chancla-slot">
          <ChanclaAnimation />
        </div>
        <MarqueeTitle />
        <p class="hook">When words fail, the Chanclazo speaks.</p>
        <div class="cta">
          <PlayNow href="#games" />
          <p class="sub">Insert chancla · free play</p>
        </div>
      </div>

      <div class="layer right desk-only">
        <div class="llama-swing" data-reveal>
          <Character kind="llama" class="llama-hero" alt="Llama piñata swinging from the papel picado" />
        </div>
        <div class="heads">
          <Character kind="lucha" class="peek-lucha" />
          <Character kind="calaca" class="peek-calaca" />
        </div>
      </div>
    </div>

    <!-- Mobile: full-face cast BELOW CTA (never under title, never headless crop) -->
    <div class="mobile-cast" aria-label="Characters">
      <Character kind="abuela" class="m-abuela" />
      <div class="llama-swing m-llama" data-reveal>
        <Character kind="llama" class="llama-hero" alt="Llama piñata" />
      </div>
      <Character kind="lucha" class="m-lucha" />
      <Character kind="calaca" class="m-calaca" />
    </div>

    <div class="fold-peek" aria-hidden="true">
      <span>Games below</span>
      <div class="peek-bar"></div>
    </div>

    <nav class="title-switch" aria-label="Title style options">
      <a href="/?title=1" class="on" title="Original wordmark">1</a>
      <a href="/?title=2" title="Lotería poster">2</a>
      <a href="/?title=3" title="Rótulo marquee">3</a>
    </nav>
  </header>

  <main>
    <GameCard
      num="I"
      name="Chancla Strike"
      kick="Game one · Physics"
      pitch="Pull back. Aim. Let it fly. Forts crumble. Luchadores drop."
      href="/fling"
      cta="Throw it →"
      color="#ff922b"
      shot="/lp/fling_loop.webp"
      shotAlt="Chancla Strike gameplay"
      shotB="/lp/fling_shot2.webp"
      shotBAlt="A chancla mid-flight"
    />
    <GameCard
      num="II"
      name="Chanclazo Match"
      kick="Game two · Puzzle"
      pitch="Sugar skulls. Piñatas. Chanclas. Line up three and chain the combos."
      href="/match"
      cta="Match it →"
      color="#38d9a9"
      shot="/lp/match_loop.webp"
      shotAlt="Chanclazo Match gameplay"
      shotB="/lp/match_shot.webp"
      shotBAlt="A Chanclazo Match board"
      reverse
    />
    <GameCard
      num="III"
      name="Piñata Slots"
      kick="Game three · Free-play slots"
      pitch="Spin for the llama piñata. Free spins, then smash with the chancla."
      href="/slots"
      cta="Spin it →"
      color="#f06595"
      shot="/lp/slots_loop.webp"
      shotAlt="Piñata Slots gameplay"
      shotB="/lp/slots_bonus.webp"
      shotBAlt="A piñata smash bonus"
      note="Working title · Free play only. No real money."
    />

    <section class="fin reveal">
      <h2>Three games.<br/>One chancla.</h2>
      <div class="fin-links">
        <a class="go" href="/fling" style="--c:#ff922b">Chancla Strike</a>
        <a class="go" href="/match" style="--c:#38d9a9">Chanclazo Match</a>
        <a class="go" href="/slots" style="--c:#f06595">Piñata Slots</a>
      </div>
      <p class="fin-note">Free in your browser. No download.</p>
    </section>
  </main>

  <footer>
    <p>© 2026 chanclazo.com · <a href="/lore">What is a chanclazo?</a></p>
  </footer>
</Base>

<style>
  .hero{
    --hero-bg:#ff8c1a;
    position:relative;
    background:var(--hero-bg);
    color:var(--ink);
    min-height:100svh;
    min-height:100dvh;
    display:flex;
    flex-direction:column;
    padding:max(6px,env(safe-area-inset-top)) 0 0;
    overflow:hidden;
  }
  .hero-rail{position:relative;z-index:6;padding:0 clamp(8px,2vw,20px)}

  .hero-stage{
    position:relative;
    z-index:4;
    flex:1;
    display:grid;
    grid-template-columns:minmax(120px,0.9fr) minmax(0,min(46vw,500px)) minmax(120px,0.9fr);
    grid-template-rows:1fr;
    grid-template-areas: "left focal right";
    align-items:start;
    gap:clamp(8px,2vw,20px);
    padding:clamp(8px,2vw,20px) clamp(12px,3vw,28px) clamp(8px,2vh,20px);
    min-height:0;
  }

  /* Focal stack — reserved vertical slots; chancla never shares a row with text */
  .focal{
    grid-area:focal;
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
    gap:0;
    z-index:10;
    padding:0 clamp(8px,2vw,20px) 8px;
    min-width:0;
    overflow:hidden;
    max-width:100%;
    align-self:start;
  }
  .chancla-slot{
    /* Layout box tall enough for spinny scale(1.15)+rotate visual extent
       (transforms do not expand layout — pad so title starts clear below). */
    display:flex;
    align-items:center;
    justify-content:center;
    width:100%;
    height:clamp(220px,24vw,270px);
    margin:0 0 8px;
    padding:0;
    overflow:visible;
    flex:none;
  }
  .hook{
    margin:8px 0 12px;
    font-size:clamp(15px,3.2vw,22px);
    font-style:italic;font-weight:600;max-width:18em;
    color:var(--ink);text-shadow:0 1px 0 rgba(255,255,255,.45);
    position:relative;z-index:2;
  }
  .cta{display:flex;flex-direction:column;align-items:center;gap:8px;position:relative;z-index:11}
  .sub{margin:0;font-family:Impact,sans-serif;font-size:clamp(10px,2vw,13px);letter-spacing:.28em;text-transform:uppercase;opacity:.85}

  .layer{position:relative;height:100%;min-height:0;pointer-events:none;z-index:2;display:flex}
  .layer.left{
    grid-area:left;
    align-self:stretch;
    flex-direction:column;
    justify-content:flex-end;
    align-items:flex-start;
    margin-left:clamp(-16px,-1.5vw,0);
    margin-bottom:0;
    overflow:visible;
  }
  .layer.left :global(.abuela-windup){width:clamp(140px,17vw,210px)}
  .layer.left :global(.abuela-windup img){width:100%;height:auto;display:block}

  .layer.right{
    grid-area:right;
    align-self:stretch;
    flex-direction:column;
    justify-content:flex-end;
    align-items:center;
    gap:clamp(8px,1.2vw,14px);
    padding-bottom:0;
    overflow:visible;
    margin:0;
  }
  .layer.right .llama-swing{width:clamp(110px,16vw,180px);margin:0 0 6px}
  .layer.right .heads{display:flex;flex-direction:row;align-items:flex-end;justify-content:center;gap:clamp(8px,1.2vw,14px);margin:0}
  :global(.peek-lucha){width:clamp(90px,12vw,150px);transform:rotate(8deg)}
  :global(.peek-calaca){width:clamp(84px,11vw,140px);transform:rotate(-5deg)}
  :global(.peek-lucha.on){transform:rotate(8deg) translateY(0)}
  :global(.peek-calaca.on){transform:rotate(-5deg) translateY(0)}

  .llama-swing{
    transform-origin:top center;
    animation:swing 3.2s ease-in-out infinite;
  }
  .llama-swing :global(.char){width:100%}
  @keyframes swing{
    0%,100%{transform:rotate(-10deg)}
    50%{transform:rotate(10deg)}
  }

  .fold-peek{
    z-index:2;display:flex;flex-direction:column;align-items:center;gap:6px;
    padding:8px 16px 0;font-size:11px;letter-spacing:3px;text-transform:uppercase;opacity:.7;
  }
  .peek-bar{
    width:min(100%,440px);height:20px;background:var(--cream);
    border-radius:14px 14px 0 0;box-shadow:0 -4px 0 rgba(42,10,0,.08);
  }
  .title-switch{
    position:absolute;top:max(8px,env(safe-area-inset-top));right:10px;z-index:30;
    display:flex;gap:6px;
  }
  .title-switch a{
    width:36px;height:36px;display:grid;place-items:center;
    border:2px solid var(--ink);border-radius:8px;
    background:rgba(255,244,224,.9);font-family:Impact,sans-serif;
    text-decoration:none;font-size:14px;min-width:44px;min-height:44px;
  }
  .title-switch a.on{background:#ffd43b;box-shadow:2px 2px 0 var(--ink)}

  @media (max-width:1024px){
    .hero-stage{grid-template-columns:minmax(90px,.85fr) minmax(0,1.15fr) minmax(90px,.85fr)}
    .layer.left :global(.abuela-windup){width:clamp(120px,18vw,180px)}
    .layer.right .llama-swing{width:clamp(96px,15vw,150px)}
    :global(.peek-lucha){width:clamp(80px,12vw,120px)}
    :global(.peek-calaca){width:clamp(72px,11vw,110px)}
  }

  .mobile-cast{display:none}
  .desk-only{display:flex}

  /* Mobile: smaller FULL-BODY abuela from bottom-left (face visible), never headless */
  @media (max-width:768px){
    .desk-only{display:none!important}
    .mobile-cast{
      display:flex;
      align-items:flex-end;
      justify-content:center;
      gap:clamp(6px,2vw,14px);
      padding:4px 12px 0;
      z-index:5;
      position:relative;
    }
    .mobile-cast :global(.m-abuela){width:clamp(88px,28vw,120px);flex:none}
    .mobile-cast :global(.m-abuela img){width:100%;height:auto}
    .mobile-cast .m-llama, .mobile-cast :global(.m-llama){width:clamp(64px,20vw,92px);flex:none;animation:swing 3.2s ease-in-out infinite;transform-origin:top center}
    .mobile-cast :global(.m-lucha){width:clamp(56px,16vw,78px);flex:none;transform:rotate(8deg)}
    .mobile-cast :global(.m-calaca){width:clamp(50px,15vw,70px);flex:none;transform:rotate(-4deg)}
    .hero-stage{
      grid-template-columns:1fr;
      grid-template-rows:auto;
      grid-template-areas: "focal";
      align-items:start;
      padding:0 12px 0;
    }
    .focal{grid-area:focal;padding:4px 8px 4px;max-width:100%;overflow:hidden}
    .chancla-slot{height:clamp(160px,44vw,220px);margin-bottom:8px}
    .hook{margin:6px 0 10px;font-size:clamp(14px,3.8vw,18px)}
    .cta{margin-top:4px}
  }

  @media (max-width:400px){
    .mobile-cast :global(.m-abuela){width:clamp(84px,30vw,110px)}
  }

  @media (orientation:landscape) and (max-height:480px){
    .fold-peek{display:none}
    .abuela-windup{width:22vw}
    .llama-swing{width:14vw}
    .peek-lucha,.peek-calaca{width:11vw}
    
  }

  .fin{text-align:center;padding:12vh 18px 6vh;background:var(--cream);color:var(--ink)}
  .fin h2{font-family:Impact,sans-serif;font-size:clamp(32px,9vw,72px);margin:0 0 20px;text-transform:uppercase;line-height:.95}
  .fin-links{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
  .fin .go{
    display:inline-flex;align-items:center;justify-content:center;min-height:44px;
    padding:12px 22px;background:var(--c);color:var(--ink);
    font-family:Impact,sans-serif;font-size:18px;text-transform:uppercase;text-decoration:none;
    box-shadow:5px 5px 0 var(--ink);border:3px solid var(--ink);border-radius:8px;
  }
  .fin-note{margin-top:28px;font-style:italic;opacity:.8}
  .fin.reveal{opacity:0;transform:translateY(28px);transition:opacity .7s,transform .7s}
  .fin.reveal.on{opacity:1;transform:none}
  footer{text-align:center;padding:20px 16px max(24px,env(safe-area-inset-bottom));font-size:12px;opacity:.7;background:var(--cream-2);color:var(--ink)}
  footer a{text-decoration:underline}
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion:reduce)').matches;
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('on');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal,[data-reveal],.char').forEach((el) => {
    if (reduce) el.classList.add('on');
    else io.observe(el);
  });
</script>
