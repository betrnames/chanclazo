---
import Base from '../layouts/Base.astro';
---
<Base>
<main class="home">
  <picture class="hero">
    <img src="/lp/lander-bg-1792.webp" srcset="/lp/lander-bg-1280.webp 1280w, /lp/lander-bg-1792.webp 1792w" sizes="(max-aspect-ratio: 1/1) 300vw, 100vw"
      width="1792" height="1008" fetchpriority="high" alt="" />
  </picture>
  <h1 class="ttl"><img id="ttl" src="/lp/lander-title.webp" width="1681" height="363" alt="Chanclazo: the abuela, the llama piñata and the luchador. When words fail, the Chanclazo speaks!" /></h1>
  <img class="herogrp" id="herogrp" src="/lp/lander-chars.webp" width="1318" height="1002" alt="" aria-hidden="true" />
  <div class="fly" id="fly" aria-hidden="true"><img class="burst" src="/lp/chancla_burst.webp" alt="" /><img class="gold" src="/lp/chancla_gold.webp" alt="" /></div>
  <div class="cta">
    <p class="tag">When words fail, the chanclazo speaks!</p>
    <a class="play" href="/choose" id="playNow">PLAY NOW</a>
    <p class="fine">Free play only · No real money · <a href="/lore">Lore</a></p>
  </div>
<button id="lmusic" class="lmusic" type="button" aria-label="Music on or off">♪ Music</button>
</main>
</Base>

<style>
  .lmusic{position:fixed;top:max(10px,env(safe-area-inset-top));right:10px;z-index:20;font:600 12px system-ui,sans-serif;color:#ffe9c2;background:rgba(20,5,15,.55);border:1px solid rgba(255,210,63,.5);border-radius:999px;padding:5px 10px;cursor:pointer}
  :global(html),:global(body){margin:0;background:#0b0301;overflow:hidden}
  .home{position:relative;height:100svh;width:100vw;overflow:hidden;font-family:LilitaOne,system-ui,sans-serif}
  .hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%}
  .ttl{margin:0;position:absolute;z-index:3;left:0;top:0;line-height:0}
  .ttl img,.herogrp{position:absolute;z-index:3;pointer-events:none;visibility:hidden;max-width:none;max-height:none} /* title + characters: never filtered/blended/overlaid */
  .fly{position:absolute;left:0;top:0;width:var(--s,150px);height:var(--s,150px);transform:translate(calc(var(--x,-999px) - 50%),calc(var(--y,-999px) - 50%));pointer-events:none;z-index:4}
  .fly img{position:absolute;inset:0;width:100%;height:100%}
  .fly .burst{filter:drop-shadow(0 0 14px rgba(255,190,40,.75));animation:burst 2.4s ease-in-out infinite}
  .fly .gold{filter:drop-shadow(0 6px 8px rgba(0,0,0,.45));animation:flip 3.2s ease-in-out infinite;transform-origin:50% 52%}
  @keyframes burst{0%,100%{opacity:.9;transform:scale(.94) rotate(-4deg)}50%{opacity:1;transform:scale(1.06) rotate(4deg)}}
    @keyframes flip{0%{transform:translateY(0) rotate(-8deg)}25%{transform:translateY(-10%) rotate(6deg)}45%{transform:translateY(-14%) rotate(368deg) scale(1.04)}70%{transform:translateY(-4%) rotate(356deg)}100%{transform:translateY(0) rotate(352deg)}}
  @media (prefers-reduced-motion:reduce){.fly .gold,.fly .burst{animation:none}}
  .cta{position:absolute;left:0;right:0;bottom:max(14px,env(safe-area-inset-bottom));display:flex;flex-direction:column;align-items:center;gap:8px}
  .play{font-size:clamp(26px,3vw,40px);color:#3b1a5c;text-decoration:none;letter-spacing:.02em;
    background:linear-gradient(180deg,#fff2a8 0%,#ffd23f 45%,#f4a000 100%);border:4px solid #3b1a5c;border-radius:999px;padding:10px 54px;
    box-shadow:0 7px 0 #3b1a5c,0 0 28px rgba(255,200,60,.6),inset 0 3px 0 rgba(255,255,255,.7);text-shadow:0 2px 0 rgba(255,255,255,.6);animation:pp 1.5s ease-in-out infinite;position:relative;overflow:hidden}
  .play::after{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 35%,rgba(255,255,255,.7) 45%,transparent 55%);background-size:300% 100%;animation:shine 3.5s ease-in-out infinite}
  @keyframes pp{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
  @keyframes shine{0%,60%{background-position:120% 0}100%{background-position:-120% 0}}
  .tag{margin:0 0 4px;font-family:system-ui,sans-serif;font-weight:700;font-size:clamp(14px,1.5vw,20px);color:#e9dcc9;text-shadow:0 2px 6px #000;text-align:center}
  .fine{margin:0;font-family:system-ui,sans-serif;font-size:12px;color:#c9b39a}
  .fine a{color:#ffd23f}
  @media (prefers-reduced-motion:reduce){.play,.play::after{animation:none}}
</style>
<script>
  // Layout: background is cover-fit by CSS. Title, character group and chancla are placed together and scale as one unit.
  const T = { w: 1681, h: 363 }, C = { w: 1318, h: 1002 };
  const fly = document.getElementById('fly')!;
  const ttl = document.getElementById('ttl') as HTMLImageElement, hero = document.getElementById('herogrp') as HTMLImageElement;
  const put = (el: HTMLElement, x: number, y: number, w: number, h: number) => Object.assign(el.style, { left: `${x}px`, top: `${y}px`, width: `${w}px`, height: `${h}px`, visibility: 'visible' });
  const place = () => {
    const vw = innerWidth, vh = (document.querySelector('.home') as HTMLElement).clientHeight;
    const ctaEl = document.querySelector('.cta') as HTMLElement, cta = ctaEl.getBoundingClientRect().height;
    if (vw / vh >= 1) {
      // Desktop: chancla, title, characters, then CTA, all fully visible.
      const ar = vw / vh, maxW = vw * (ar > 2.6 ? 0.4 : ar > 2 ? 0.48 : ar > 1.7 ? 0.58 : 0.64);
      const top = 12, bot = cta + 24, availH = vh - top - bot;
      // unit u = title width; title h = u*T.h/T.w; chars w = 0.78u; chancla room above title = 0.12u
      const tH = T.h / T.w, cW = 0.85, cH = cW * C.h / C.w, chR = 0.12, gap = -0.02;
      const u = Math.min(maxW, availH / (chR + tH + gap + cH));
      const used = u * (chR + tH + gap + cH), y0 = top + Math.max(0, (availH - used) / 2) + u * chR;
      const tx = (vw - u) / 2;
      put(ttl, tx, y0, u, u * tH);
      const cy = y0 + u * (tH + gap);
      put(hero, (vw - u * cW) / 2, cy, u * cW, u * cH);
      const size = Math.min(u * 0.22, 360);
      fly.style.setProperty('--x', `${vw / 2}px`); fly.style.setProperty('--y', `${y0 - size * 0.02}px`); fly.style.setProperty('--s', `${size}px`);
      Object.assign(ctaEl.style, { top: `${Math.min(cy + u * cH + 8, vh - cta - 12)}px`, bottom: 'auto' });
    } else {
      // Mobile/portrait: title on top, PLAY NOW right under it, characters fill the space below.
      const pad = Math.max(10, vw * 0.04), u = Math.min(vw - 2 * pad, 640), tH = u * T.h / T.w;
      const size = Math.min(u * 0.3, 220), y0 = 36 + size * 0.45;
      put(ttl, (vw - u) / 2, y0, u, tH);
      fly.style.setProperty('--x', `${vw / 2}px`); fly.style.setProperty('--y', `${y0 - size * 0.05}px`); fly.style.setProperty('--s', `${size}px`);
      const ctop = y0 + tH + 6;
      Object.assign(ctaEl.style, { top: `${ctop}px`, bottom: 'auto' });
      const cTop = ctop + cta + 10, availH = vh - cTop - 10;
      const cw = Math.min(vw - 2 * pad, availH * C.w / C.h, 700), ch = cw * C.h / C.w;
      put(hero, (vw - cw) / 2, cTop + Math.max(0, (availH - ch) * 0.4), cw, ch);
    }
  };
  place(); addEventListener('resize', place);
  import { initLanderMusic } from '../../src/play/music';
  initLanderMusic(document.getElementById('lmusic') as HTMLButtonElement);
  document.getElementById('playNow')?.addEventListener('click', () => {
    const w = window as any;
    if (w.gtag) { w.gtag('event', 'hero_play_click', { game: 'home' }); w.gtag('event', 'landing_card_click', { game: 'hero_play' }); }
  });
</script>
