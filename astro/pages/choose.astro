---
import Base from '../layouts/Base.astro';
import PapelPicado from '../components/PapelPicado.astro';
const pins = [
  { game: 'slots', href: '/slots', name: 'Piñata Slots', place: 'The Piñata Plaza', thumb: '/lp/thumb_slots.webp', spr: '/play/t_pinata.webp', c: '#e2197a', d: [17, 60], m: [44, 17] },
  { game: 'match', href: '/match', name: 'Chanclazo Match', place: 'Calaca Courtyard', thumb: '/lp/thumb_match.webp', spr: '/play/t_skull.webp', c: '#18b5b0', d: [50, 36], m: [56, 49] },
  { game: 'fling', href: '/fling', name: 'Chancla Strike', place: "Abuela's Altar", thumb: '/lp/thumb_fling.webp', spr: '/play/abuela_sprite.webp', c: '#f7a21b', d: [83, 60], m: [44, 80] },
];
const stars = Array.from({ length: 40 }, (_, i) => ({ x: (i * 41) % 100, y: (i * 23) % 38, s: 1 + (i % 3), d: -(i * 0.31) }));
const houses = [
  { x: 2, w: 9, h: 16, c: '#4a1f6e' }, { x: 11, w: 7, h: 22, c: '#3d1760' }, { x: 26, w: 10, h: 14, c: '#2a5a6e' }, { x: 37, w: 6, h: 25, c: '#4a1f6e' },
  { x: 58, w: 8, h: 18, c: '#3d1760' }, { x: 66, w: 11, h: 13, c: '#2a5a6e' }, { x: 88, w: 10, h: 20, c: '#4a1f6e' },
];
const candles = [[8, 88], [24, 80], [44, 90], [61, 84], [76, 92], [93, 86]];
---
<Base title="Chanclazo: Pick your game on the map">
<main class="mapwrap">
  <header class="top">
    <a class="back" href="/">← Home</a>
    <h1>Pick your stop</h1>
    <p class="tag">Follow the marigold trail through town and choose a game.</p>
  </header>
  <div class="map">
    <div class="sky" aria-hidden="true">
      <i class="moon"></i>
      {stars.map((s) => <i class="star" style={`left:${s.x}%;top:${s.y}%;--s:${s.s}px;animation-delay:${s.d}s`}></i>)}
    </div>
    <div class="rail" aria-hidden="true"><PapelPicado /></div>
    <div class="town" aria-hidden="true">
      {houses.map((h) => <i class="house" style={`left:${h.x}%;width:${h.w}%;height:${h.h}%;--c:${h.c}`}><b></b></i>)}
    </div>
    <svg class="path d" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 17 66 C 28 80, 38 30, 50 42 S 72 78, 83 66" />
    </svg>
    <svg class="path m" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 44 22 C 70 28, 70 40, 56 53 S 30 70, 44 84" />
    </svg>
    {candles.map(([x, y]) => <i class="candle" style={`left:${x}%;top:${y}%`} aria-hidden="true"><b></b></i>)}
    {pins.map((p, i) => (
      <div class="pin" style={`--dx:${p.d[0]}%;--dy:${p.d[1]}%;--mx:${p.m[0]}%;--my:${p.m[1]}%;--c:${p.c};--i:${i}`}>
        <a class="medal" href={p.href} data-game={p.game} aria-label={`Play ${p.name}`}>
          <img class="thumb" src={p.thumb} alt="" loading="lazy" />
          <img class="spr" src={p.spr} alt="" />
        </a>
        <div class="label">
          <small>{p.place}</small>
          <b>{p.name}</b>
          <a class="play" href={p.href} data-game={p.game}>PLAY</a>
        </div>
      </div>
    ))}
  </div>
  <footer>Free play only · No real money · <a href="/lore">Lore</a></footer>
</main>
</Base>

<style>
  :global(html),:global(body){margin:0;background:#120818}
  .mapwrap{min-height:100svh;font-family:LilitaOne,system-ui,sans-serif;color:#fff;display:flex;flex-direction:column}
  .top{position:relative;text-align:center;padding:12px 14px 4px;z-index:5}
  .back{position:absolute;left:14px;top:14px;color:#3b1a5c;background:#ffd23f;border:3px solid #3b1a5c;border-radius:12px;padding:4px 12px;text-decoration:none;font-size:16px}
  h1{margin:0;font-weight:400;font-size:clamp(30px,4.4vw,52px);color:#ffd23f;-webkit-text-stroke:6px #3b1a5c;paint-order:stroke fill;text-shadow:0 5px 0 #3b1a5c,0 0 24px rgba(255,190,60,.45)}
  .tag{margin:2px 0 0;font-family:system-ui,sans-serif;font-size:15px;color:#ffe9c2}
  .map{position:relative;flex:1;min-height:560px;margin:8px 12px 0;border-radius:24px;overflow:hidden;border:4px solid #ffd23f55;
    background:linear-gradient(180deg,#1a0b2e 0%,#2a0f45 40%,#21405a 72%,#3a1a2e 100%)}
  .sky .moon{position:absolute;right:8%;top:10%;width:70px;height:70px;border-radius:50%;background:radial-gradient(circle at 40% 40%,#fff7d6,#ffe08a 60%,#f4b000);box-shadow:0 0 40px 12px rgba(255,224,138,.35)}
  .star{position:absolute;width:var(--s);height:var(--s);border-radius:50%;background:#fff8d6;animation:tw 3s ease-in-out infinite}
  @keyframes tw{0%,100%{opacity:.25}50%{opacity:1}}
  .rail{position:absolute;left:0;right:0;top:0;opacity:.95}
  .town{position:absolute;left:0;right:0;bottom:0;height:100%}
  .house{position:absolute;bottom:0;background:var(--c);border-radius:6px 6px 0 0;opacity:.9}
  .house::before{content:'';position:absolute;left:-8%;right:-8%;top:-14px;height:16px;background:#5a2d86;clip-path:polygon(0 100%,50% 0,100% 100%)}
  .house b{position:absolute;inset:18% 16% 30%;background:repeating-linear-gradient(90deg,#ffcf56 0 8px,transparent 8px 20px);opacity:.6;-webkit-mask:repeating-linear-gradient(180deg,#000 0 10px,transparent 10px 24px);mask:repeating-linear-gradient(180deg,#000 0 10px,transparent 10px 24px)}
  .path{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .path path{fill:none;stroke:#f7a21b;stroke-width:1.1;stroke-linecap:round;stroke-dasharray:.1 2.6;vector-effect:non-scaling-stroke;filter:drop-shadow(0 0 4px #ffb347);animation:march 2.5s linear infinite}
  .path path{stroke-width:9px}
  @keyframes march{to{stroke-dashoffset:-27}}
  .path.m{display:none}
  .candle{position:absolute;width:10px;height:22px;margin-left:-5px;background:#fff1d0;border-radius:2px;box-shadow:0 0 14px 4px rgba(255,180,60,.35)}
  .candle b{position:absolute;left:50%;top:-14px;width:10px;height:14px;margin-left:-5px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;background:radial-gradient(circle at 50% 70%,#fff6c2,#ffb347 55%,#ff5a36);animation:flick .5s ease-in-out infinite alternate}
  @keyframes flick{from{transform:scaleY(1) rotate(-3deg)}to{transform:scaleY(1.2) rotate(3deg)}}
  .pin{position:absolute;left:var(--dx);top:var(--dy);transform:translate(-50%,-50%);z-index:4;display:flex;flex-direction:column;align-items:center;width:clamp(170px,19vw,250px)}
  .medal{position:relative;display:block;width:100%;aspect-ratio:25/16;border-radius:18px;border:5px solid var(--c);box-shadow:0 0 0 4px #3b1a5c,0 0 30px color-mix(in srgb,var(--c) 70%,transparent),0 14px 24px rgba(0,0,0,.5);background:#3b1a5c;animation:float 3.4s ease-in-out infinite;animation-delay:calc(var(--i) * -1.1s);transition:transform .15s}
  .medal .thumb{width:100%;height:100%;object-fit:cover;border-radius:13px;display:block}
  .medal .spr{position:absolute;right:-14%;bottom:-18%;height:72%;filter:drop-shadow(2px 0 0 #3b1a5c) drop-shadow(-2px 0 0 #3b1a5c) drop-shadow(0 2px 0 #3b1a5c) drop-shadow(0 -2px 0 #3b1a5c) drop-shadow(0 8px 10px rgba(0,0,0,.5))}
  .medal::after{content:'';position:absolute;left:50%;bottom:-22px;width:0;height:0;margin-left:-12px;border:12px solid transparent;border-top:14px solid var(--c)}
  .pin:hover .medal,.medal:focus-visible{transform:translateY(-6px) scale(1.04)}
  @keyframes float{0%,100%{translate:0 0}50%{translate:0 -8px}}
  .label{margin-top:26px;text-align:center;background:#3b1a5ccc;border:3px solid var(--c);border-radius:14px;padding:6px 12px 10px;backdrop-filter:blur(2px)}
  .label small{display:block;font-family:system-ui,sans-serif;font-size:12px;font-weight:700;color:#ffe9c2;letter-spacing:.04em}
  .label b{display:block;font-weight:400;font-size:clamp(18px,1.7vw,24px);color:#fff}
  .label .play{display:inline-block;margin-top:6px;color:#3b1a5c;text-decoration:none;font-size:20px;background:linear-gradient(180deg,#fff2a8,#ffd23f 45%,#f4a000);border:3px solid #3b1a5c;border-radius:999px;padding:4px 26px;box-shadow:0 4px 0 #3b1a5c}
  .label .play:active{transform:translateY(3px);box-shadow:0 1px 0 #3b1a5c}
  footer{text-align:center;padding:10px 16px max(14px,env(safe-area-inset-bottom));font-family:system-ui,sans-serif;font-size:13px;color:#ffe9c2}
  footer a{color:#ffd23f}
  @media (max-aspect-ratio: 1/1){
    .map{min-height:1180px;margin:8px 8px 0}
    .path.d{display:none}.path.m{display:block}
    .pin{left:var(--mx);top:var(--my);width:min(58vw,240px)}
    .medal .spr{right:-18%;height:60%}
    .back{position:static;display:inline-block;margin-bottom:6px}
    .top{text-align:center}
  }
  @media (prefers-reduced-motion:reduce){.medal,.path path,.star,.candle b{animation:none}}
</style>
<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-game]').forEach((a) => a.addEventListener('click', () => {
    const w = window as any; if (w.gtag) w.gtag('event', 'landing_card_click', { game: a.dataset.game, source: 'map' });
  }));
</script>
