---
import Base from '../layouts/Base.astro';
import PapelPicado from '../components/PapelPicado.astro';
const games = [
  { game: 'slots', href: '/slots', name: 'Piñata Slots', line: 'Spin the 5×4 reels, smash piñatas, win free spins.', img: '/play/t_pinata.webp', alt: 'The llama piñata', cls: 'llama', c: '#e2197a' },
  { game: 'match', href: '/match', name: 'Chanclazo Match', line: 'Swap, match and smash your way through 8 levels.', img: '/play/luchador_sprite.webp', alt: 'The luchador', cls: 'lucha', c: '#18b5b0' },
  { game: 'fling', href: '/fling', name: 'Chancla Strike', line: 'Fling the chancla and topple the villains.', img: '/play/abuela_sprite.webp', alt: 'The abuela', cls: 'abuela', c: '#f7a21b' },
];
---
<Base title="Chanclazo: Choose your game">
<main class="choose">
  <div class="rail" aria-hidden="true"><PapelPicado /></div>
  <header><a class="back" href="/">← Home</a><h1>Choose your game</h1></header>
  <div class="car" role="region" aria-roledescription="carousel" aria-label="Games">
    <button class="arrow prev" type="button" aria-label="Previous game">‹</button>
    <div class="track" id="track" tabindex="0">
      {games.map((g, i) => (
        <section class="slide" aria-roledescription="slide" aria-label={`${i + 1} of 3: ${g.name}`} style={`--c:${g.c}`}>
          <div class="card">
            <div class="art">
              <i class="glow" aria-hidden="true"></i>
              <img class={g.cls} src={g.img} alt={g.alt} draggable="false" />
            </div>
            <h2>{g.name}</h2>
            <p>{g.line}</p>
            <a class="play" href={g.href} data-game={g.game}>PLAY</a>
          </div>
        </section>
      ))}
    </div>
    <button class="arrow next" type="button" aria-label="Next game">›</button>
  </div>
  <div class="dots" role="tablist" aria-label="Choose slide">
    {games.map((g, i) => <button type="button" role="tab" aria-label={g.name} data-i={i}></button>)}
  </div>
  <p class="fine">Free play only · No real money</p>
</main>
</Base>

<style>
  :global(html),:global(body){margin:0;background:#0b0301}
  .choose{min-height:100svh;display:flex;flex-direction:column;font-family:LilitaOne,system-ui,sans-serif;color:#fff;
    background:radial-gradient(ellipse at 50% 35%,#3d1760 0%,#1f0a30 45%,#0b0301 100%);overflow:hidden}
  .rail{opacity:.9}
  header{position:relative;text-align:center;padding:4px 14px 0}
  .back{position:absolute;left:14px;top:6px;color:#3b1a5c;background:#ffd23f;border:3px solid #3b1a5c;border-radius:12px;padding:3px 12px;text-decoration:none;font-size:16px}
  h1{margin:0;font-weight:400;font-size:clamp(26px,4vw,44px);color:#ffd23f;-webkit-text-stroke:5px #3b1a5c;paint-order:stroke fill;text-shadow:0 4px 0 #3b1a5c,0 0 22px rgba(255,190,60,.4)}
  .car{position:relative;flex:1;display:flex;align-items:center;min-height:0}
  .track{flex:1;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;height:100%;outline:none;cursor:grab}
  .track::-webkit-scrollbar{display:none}
  .track.drag{cursor:grabbing;scroll-snap-type:none;scroll-behavior:auto}
  .slide{flex:0 0 100%;scroll-snap-align:center;display:flex;align-items:center;justify-content:center;padding:12px 16px;box-sizing:border-box}
  .card{width:min(460px,86vw);text-align:center;border-radius:28px;padding:18px 20px 22px;box-sizing:border-box;
    background:radial-gradient(ellipse at 50% 30%,#4a1f6e,#24092f 70%);border:4px solid var(--c);
    box-shadow:0 0 0 4px #14050f,0 0 40px color-mix(in srgb,var(--c) 45%,transparent),0 18px 40px rgba(0,0,0,.6)}
  .art{position:relative;height:clamp(200px,38svh,340px);display:flex;align-items:flex-end;justify-content:center}
  .glow{position:absolute;left:50%;top:50%;width:80%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--c) 55%,transparent),transparent 65%);animation:pulse 3s ease-in-out infinite}
  .art img{position:relative;height:100%;width:auto;max-width:100%;object-fit:contain;filter:drop-shadow(0 0 2px #14050f) drop-shadow(0 12px 16px rgba(0,0,0,.6));animation:bob 3.2s ease-in-out infinite;user-select:none}
  .art img.llama{height:min(100%,240px)}  /* small source art: scale modestly to stay sharp */
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  @keyframes pulse{0%,100%{opacity:.7}50%{opacity:1}}
  h2{margin:12px 0 4px;font-weight:400;font-size:clamp(28px,3.4vw,38px);color:#ffd23f;-webkit-text-stroke:5px #3b1a5c;paint-order:stroke fill}
  .card p{margin:0 0 14px;font-family:system-ui,sans-serif;font-size:16px;color:#ffe9c2}
  .play{display:inline-block;font-size:26px;color:#3b1a5c;text-decoration:none;background:linear-gradient(180deg,#fff2a8,#ffd23f 45%,#f4a000);border:4px solid #3b1a5c;border-radius:999px;padding:8px 48px;box-shadow:0 6px 0 #3b1a5c,0 0 22px rgba(255,200,60,.5)}
  .play:active{transform:translateY(3px);box-shadow:0 3px 0 #3b1a5c}
  .arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:56px;height:56px;border-radius:50%;border:3px solid #3b1a5c;background:#ffd23f;color:#3b1a5c;font-size:36px;line-height:1;cursor:pointer;box-shadow:0 5px 0 #3b1a5c}
  .arrow:disabled{opacity:.35;cursor:default}
  .prev{left:max(12px,calc(50% - 360px))}.next{right:max(12px,calc(50% - 360px))}
  .dots{display:flex;justify-content:center;gap:10px;padding:6px 0 4px}
  .dots button{width:12px;height:12px;border-radius:50%;border:2px solid #ffd23f;background:transparent;padding:0;cursor:pointer}
  .dots button[aria-selected="true"]{background:#ffd23f;width:28px;border-radius:8px}
  .fine{margin:0 0 max(12px,env(safe-area-inset-bottom));text-align:center;font-family:system-ui,sans-serif;font-size:12px;color:#c9b39a}
  @media (max-width:640px){.arrow{display:none}.back{position:static;display:inline-block;margin-bottom:4px}}
  @media (prefers-reduced-motion:reduce){.art img,.glow{animation:none}.track{scroll-behavior:auto}}
</style>
<script>
  const track = document.getElementById('track')!;
  const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('.dots button')];
  const prev = document.querySelector<HTMLButtonElement>('.prev')!, next = document.querySelector<HTMLButtonElement>('.next')!;
  const idx = () => Math.round(track.scrollLeft / track.clientWidth);
  const go = (i: number) => { i = Math.max(0, Math.min(slides.length - 1, i)); track.scrollTo({ left: i * track.clientWidth }); };
  const sync = () => { const i = idx(); dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i))); prev.disabled = i === 0; next.disabled = i === slides.length - 1; };
  track.addEventListener('scroll', () => requestAnimationFrame(sync)); sync();
  prev.onclick = () => go(idx() - 1); next.onclick = () => go(idx() + 1);
  dots.forEach((d) => (d.onclick = () => go(Number(d.dataset.i))));
  addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(idx() + 1); if (e.key === 'ArrowLeft') go(idx() - 1); });
  // mouse drag (touch uses native swipe + scroll-snap)
  let down = false, sx = 0, sl = 0, moved = false;
  track.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; sx = e.clientX; sl = track.scrollLeft; track.classList.add('drag'); });
  addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - sx; if (Math.abs(dx) > 5) moved = true; track.scrollLeft = sl - dx; });
  addEventListener('pointerup', (e) => { if (!down) return; down = false; track.classList.remove('drag'); const dx = e.clientX - sx, base = Math.round(sl / track.clientWidth); go(base + (dx < -60 ? 1 : dx > 60 ? -1 : 0)); });
  track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
  document.querySelectorAll<HTMLAnchorElement>('a[data-game]').forEach((a) => a.addEventListener('click', () => {
    const w = window as any; if (w.gtag) w.gtag('event', 'landing_card_click', { game: a.dataset.game, source: 'carousel' });
  }));
</script>
