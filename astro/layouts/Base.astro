---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
interface Props {
  title?: string;
  description?: string;
}
const site = import.meta.env.VITE_SITE_URL || 'https://chanclazo.com';
const {
  title = 'Chanclazo',
  description = 'When words fail, the Chanclazo speaks. Day of the Dead browser games: Chancla Strike and Piñata Slots.',
} = Astro.props;
const ogAlt = 'Chanclazo: the gold wordmark and gold chancla, with a sugar-skull boy and girl above little skeletons in a candlelit Day of the Dead plaza.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#ff8c1a" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Chanclazo" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${site}/`} />
  <meta property="og:image" content={`https://chanclazo.com/og/chanclazo-share-v3-1200x630.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://chanclazo.com/og/chanclazo-share-v3-1200x630.jpg`} />
  <meta name="twitter:image:alt" content={ogAlt} />
  <link rel="icon" href="/cruise/logo_chancla.webp" />
  <link rel="apple-touch-icon" href="/play/icon-180.png" />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/LilitaOne-Regular.woff2" crossorigin />
  <slot name="head" />
</head>
<body>
  <slot />
  <Analytics />
<div class="cz-copy" style="position:fixed;left:50%;transform:translateX(-50%);bottom:max(4px,env(safe-area-inset-bottom));z-index:30;pointer-events:none;font:10px system-ui,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.85);text-shadow:0 1px 3px rgba(0,0,0,.9),0 0 6px rgba(0,0,0,.7);display:flex;align-items:center;gap:8px;white-space:nowrap">© 2023 Chanclazo™ <span class="cz-build" style="font-size:8px;letter-spacing:.08em;text-transform:none;opacity:.6">%%CZ_BUILD%%</span></div>
</body>
</html>
