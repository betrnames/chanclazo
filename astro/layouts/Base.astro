---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
interface Props {
  title?: string;
  description?: string;
}
const site = import.meta.env.VITE_SITE_URL || 'https://chanclazo.com';
const {
  title = 'Chanclazo',
  description = 'When words fail, the Chanclazo speaks. Day of the Dead browser games: Chancla Strike and Piñata Slots.',
} = Astro.props;
const ogAlt = 'Chanclazo: the abuela with a flying chancla, luchador and sugar skull heads, and marigold petals; chips for Chancla Strike, Chanclazo Match, and Piñata Slots.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#ff8c1a" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Chanclazo" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${site}/`} />
  <meta property="og:image" content={`${site}/og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${site}/og.png`} />
  <meta name="twitter:image:alt" content={ogAlt} />
  <link rel="icon" href="/cruise/logo_chancla.webp" />
  <link rel="apple-touch-icon" href="/play/icon-180.png" />
</head>
<body>
  <slot />
  <Analytics />
<div class="cz-copy" style="position:fixed;left:50%;transform:translateX(-50%);bottom:max(4px,env(safe-area-inset-bottom));z-index:30;pointer-events:none;font:10px system-ui,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.85);text-shadow:0 1px 3px rgba(0,0,0,.9),0 0 6px rgba(0,0,0,.7);display:flex;align-items:center;gap:8px;white-space:nowrap">© 2023 Chanclazo™ <a href="https://x.com/ChanclaStrike" target="_blank" rel="noopener" aria-label="Chanclazo on X (@ChanclaStrike)" style="pointer-events:auto;color:inherit;text-decoration:none;text-transform:none;letter-spacing:.05em;display:inline-flex;align-items:center;gap:4px"><svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true" style="vertical-align:-1px;fill:currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>@ChanclaStrike</a><span class="cz-build" style="font-size:8px;letter-spacing:.08em;text-transform:none;opacity:.6">%%CZ_BUILD%%</span></div>
</body>
</html>
