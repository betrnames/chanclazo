---
/** Title options via ?title=1|2|3 (client-switched for static CF Pages) */
const letters = ['C','h','a','n','c','l','a','z','o'];
---
<div class="wordmark opt-1" data-title-opt="1" id="wordmark">
  <h1 class="letters" aria-label="Chanclazo">
    {letters.map((L, i) => <span style={`--i:${i}`}>{L}</span>)}
  </h1>
</div>
<style>
  .wordmark{
    width:100%;
    max-width:100%;
    container-type:inline-size;
    container-name:title;
    overflow:visible;
    /* pad for 3D extrude / outline so glyphs aren't clipped by ancestors */
    padding:0.12em 0.2em 0.28em;
    box-sizing:border-box;
  }
  .letters{
    margin:0;
    line-height:.95;
    letter-spacing:0.01em;
    text-transform:uppercase;
    display:flex;
    flex-wrap:nowrap;
    justify-content:center;
    width:100%;
    max-width:100%;
    white-space:nowrap;
    overflow:visible;
  }
  .letters span{
    flex:none;
    display:inline-block;
    animation:wob 2.2s ease-in-out infinite;
    animation-delay:calc(var(--i) * -.18s);
  }
  @keyframes wob{
    0%,100%{transform:translateY(0) rotate(-3deg)}
    50%{transform:translateY(-10px) rotate(3deg)}
  }

  /*
   * Size from container width (cqi) so "CHANCLAZO" + outline/shadow always fits.
   * Fallback vw clamps for older engines. ~9 letters ≈ 5.6–6.2em wide depending on face.
   */
  .opt-1 .letters{
    font-family:Impact,"Arial Black",sans-serif;
    font-size:clamp(28px, min(12cqi, 7vw), 92px);
  }
  .opt-1 .letters span{
    color:#f3e9d2;
    -webkit-text-stroke:clamp(1px,.2vw,3px) #2a0a00;
    paint-order:stroke fill;
    text-shadow:3px 3px 0 #c2255c,6px 6px 0 #5f3dc4,9px 9px 0 #0b0614,0 0 18px rgba(255,212,59,.35);
  }

  .opt-2 .letters{
    font-family:LilitaOne,Impact,sans-serif;
    font-size:clamp(26px, min(11.5cqi, 6.6vw), 86px);
    letter-spacing:.02em;
  }
  .opt-2 .letters span{
    color:#fff8e7;
    -webkit-text-stroke:clamp(2px,.35vw,5px) #2a0a00;
    paint-order:stroke fill;
    text-shadow:3px 3px 0 #e03131,6px 6px 0 #c2255c,9px 9px 0 #2a0a00;
  }

  .opt-3 .letters{
    font-family:Frijole,EmblemaOne,Impact,sans-serif;
    font-size:clamp(22px, min(10cqi, 5.8vw), 76px);
    letter-spacing:.02em;
  }
  .opt-3 .letters span{
    color:#ffd43b;
    -webkit-text-stroke:clamp(2px,.3vw,4px) #2a0a00;
    paint-order:stroke fill;
    text-shadow:2px 2px 0 #f06595,4px 4px 0 #c2255c,7px 7px 0 #2a0a00,0 0 12px rgba(255,140,26,.5);
  }

  @supports not (font-size:1cqi){
    .opt-1 .letters{font-size:clamp(28px,6.5vw,84px)}
    .opt-2 .letters{font-size:clamp(26px,6vw,80px)}
    .opt-3 .letters{font-size:clamp(22px,5.2vw,68px)}
  }

  @media (max-width:420px){
    .opt-1 .letters{font-size:clamp(32px, min(14cqi, 11vw), 48px)}
    .opt-2 .letters{font-size:clamp(30px, min(13cqi, 10vw), 44px)}
    .opt-3 .letters{font-size:clamp(26px, min(11cqi, 9vw), 40px)}
  }
</style>
<script>
  (function () {
    const wm = document.getElementById('wordmark');
    if (!wm) return;
    const apply = () => {
      const t = new URLSearchParams(location.search).get('title');
      const opt = t === '2' ? '2' : t === '3' ? '3' : '1';
      wm.classList.remove('opt-1', 'opt-2', 'opt-3');
      wm.classList.add('opt-' + opt);
      wm.dataset.titleOpt = opt;
      document.querySelectorAll('.title-switch a').forEach((a) => {
        a.classList.toggle('on', a.getAttribute('href') === '/?title=' + opt);
      });
      const hero = document.getElementById('top');
      if (hero) hero.dataset.title = opt;
    };
    apply();
    document.querySelectorAll('.title-switch a').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const href = a.getAttribute('href') || '/?title=1';
        history.replaceState(null, '', href);
        apply();
      });
    });
  })();
</script>
