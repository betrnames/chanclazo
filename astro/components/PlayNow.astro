---
interface Props { href?: string }
const { href = '#games' } = Astro.props;
---
<a class="arcade-btn" id="heroPlay" href={href}>PLAY NOW</a>
<style>
  .arcade-btn{
    appearance:none;border:0;cursor:pointer;text-decoration:none;
    display:inline-flex;align-items:center;justify-content:center;
    min-height:var(--tap);
    font-family:Impact,"Arial Black",sans-serif;
    font-size:clamp(22px,5.5vw,40px);
    letter-spacing:.06em;text-transform:uppercase;
    color:#fff;
    -webkit-text-stroke:2px #2a0a00;paint-order:stroke fill;
    padding:clamp(14px,2.2vw,20px) clamp(28px,6vw,56px);
    border-radius:999px;
    background:radial-gradient(120% 120% at 30% 20%,#ff6b6b 0%,#e03131 45%,#c92a2a 100%);
    box-shadow:
      inset 0 6px 0 rgba(255,255,255,.45),
      inset 0 -10px 0 rgba(0,0,0,.28),
      0 0 0 5px #2a0a00,
      0 0 0 10px #ffd43b,
      0 14px 0 #7a1010,
      0 18px 28px rgba(42,10,0,.35);
    transform:translateY(0);
    animation:coinpulse 1.6s ease-in-out infinite;
    transition:transform .08s,box-shadow .08s;
  }
  .arcade-btn:hover{filter:brightness(1.05)}
  .arcade-btn:active,.arcade-btn.pressed{
    transform:translateY(10px);
    box-shadow:
      inset 0 4px 0 rgba(255,255,255,.3),
      inset 0 -6px 0 rgba(0,0,0,.3),
      0 0 0 5px #2a0a00,
      0 0 0 10px #ffd43b,
      0 4px 0 #7a1010,
      0 8px 16px rgba(42,10,0,.3);
    animation:none;
  }
  @keyframes coinpulse{0%,100%{filter:brightness(1)}50%{filter:brightness(1.12)}}
</style>
<script>
  const btn = document.getElementById('heroPlay');
  if (btn) {
    btn.addEventListener('click', () => {
      btn.classList.add('pressed');
      setTimeout(() => btn.classList.remove('pressed'), 140);
      try {
        if (window.gtag) {
          window.gtag('event', 'hero_play_click', { game: 'home' });
          window.gtag('event', 'landing_card_click', { game: 'hero_play' });
        }
      } catch (_) {}
    });
  }
</script>
